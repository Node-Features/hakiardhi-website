								"body": {
									"mode": "raw",
									"raw": "{\n  \"entity_type\": \"case\",\n  \"entity_id\": \"{{case_id}}\",\n  \"job_type\": \"notification\",\n  \"recipients\": [\n    {\n      \"recipient_id\": \"user123\",\n      \"channel\": \"sms\",\n      \"destination\": \"+255712345678\",\n      \"message\": \"Your case has been updated\"\n    },\n    {\n      \"recipient_id\": \"user456\",\n      \"channel\": \"email\",\n      \"destination\": \"user@example.com\",\n      \"message\": \"Your case status has changed\"\n    }\n  ]\n}"
								},
