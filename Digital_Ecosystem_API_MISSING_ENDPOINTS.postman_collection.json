								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    const response = pm.response.json();",
											"    if (response.jobId) {",
											"        pm.environment.set('message_job_id', response.jobId);",
											"        console.log('✅ Message Job ID saved:', response.jobId);",
											"    }",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
