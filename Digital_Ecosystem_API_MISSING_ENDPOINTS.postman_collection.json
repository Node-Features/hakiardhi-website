										"exec": [
											"if (pm.response.code === 200) {",
											"    const response = pm.response.json();",
											"    if (response.data && response.data.length > 0) {",
											"        pm.environment.set('publication_id', response.data[0].id);",
											"        console.log('✅ Publication ID saved:', response.data[0].id);",
											"    }",
											"}"
										],
