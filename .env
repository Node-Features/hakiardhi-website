# API Configuration
# Empty string uses Next.js proxy (recommended - no CORS issues)
# The proxy is configured in next.config.ts to forward to:
#   - Development: http://localhost:3001
#   - Production: https://hakiardhi-api.vercel.app
# Leave empty to use the proxy configuration
# Use empty string to leverage Next.js rewrites proxy (avoids CORS)
NEXT_PUBLIC_API_URL=